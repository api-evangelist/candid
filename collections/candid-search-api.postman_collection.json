  "info": {
    "_postman_id": "80fb79c9-b7c3-445f-b1d1-0466d6f32fa0",
    "name": "Candid Essentials Lookup Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Candid Essentials API provides core nonprofit search and lookup over Candid's database of U.S. nonprofits. It supports search by name, EIN, location, NTEE code, organization size, and other criteria, and returns summary records suitable for autocompletes, lookups, and basic-verification flows. Multiple versions (v1-v4) are available with POST search and GET lookup variants.\n\nContact Support:\n Name: Candid Developer Support",
      "type": "text/plain"
    }
  }
